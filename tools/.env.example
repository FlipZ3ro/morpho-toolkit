# Copy to .env and keep that file private. Never commit a real key.
PRIVATE_KEY=0xYOUR_64_HEX_PRIVATE_KEY

# Public fallbacks are for connectivity checks only. Use dedicated RPCs for arb.
ETHEREUM_RPC_URL=https://ethereum-rpc.publicnode.com
BASE_RPC_URL=https://base-rpc.publicnode.com
ARBITRUM_RPC_URL=https://arb1.arbitrum.io/rpc
POLYGON_RPC_URL=https://polygon-bor-rpc.publicnode.com
OPTIMISM_RPC_URL=https://mainnet.optimism.io
ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com
HYPEREVM_RPC_URL=https://rpc.hyperliquid.xyz/evm
STABLE_RPC_URL=https://rpc.stable.xyz
MONAD_RPC_URL=https://rpc.monad.xyz
TEMPO_RPC_URL=https://rpc.tempo.xyz
KATANA_RPC_URL=https://rpc.katana.network
